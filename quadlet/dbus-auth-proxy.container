[Unit]
Description=DBus Auth Proxy Container

[Container]
# Built locally from this checkout by dbus-auth-proxy.build; never pulled.
Image=dbus-auth-proxy.build

Volume=dbus-socket:/run/dbus-auth-proxy:rw
Volume=/run/dbus:/run/dbus:rw

UserNS=keep-id
SecurityLabelDisable=true

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
